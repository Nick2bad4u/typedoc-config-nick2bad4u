{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "typedoc-config-nick2bad4u",
    "version": "2.0.3",
    "private": false,
    "description": "Shared TypeDoc config for Nick2bad4u TypeScript projects.",
    "keywords": [
        "documentation",
        "typedoc",
        "typedoc-config",
        "typescript",
        "shared-config"
    ],
    "homepage": "https://github.com/Nick2bad4u/typedoc-config-nick2bad4u",
    "bugs": {
        "url": "https://github.com/Nick2bad4u/typedoc-config-nick2bad4u/issues",
        "email": "20943337+Nick2bad4u@users.noreply.github.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Nick2bad4u/typedoc-config-nick2bad4u.git"
    },
    "license": "MIT",
    "author": "Nick2bad4u <20943337+Nick2bad4u@users.noreply.github.com> (https://github.com/Nick2bad4u)",
    "contributors": [
        {
            "name": "Nick2bad4u",
            "email": "20943337+Nick2bad4u@users.noreply.github.com",
            "url": "https://github.com/Nick2bad4u"
        }
    ],
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/preset.d.ts",
            "import": "./dist/preset.js",
            "require": null
        },
        "./typedoc.json": "./typedoc.json",
        "./package.json": "./package.json"
    },
    "main": "./dist/preset.js",
    "types": "./dist/preset.d.ts",
    "files": [
        "dist",
        "typedoc.json"
    ],
    "scripts": {
        "build": "npm run clean:dist && tsc -p tsconfig.build.json",
        "build:runtime": "npm run build",
        "changelog:generate": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --github-repo Nick2bad4u/typedoc-config-nick2bad4u --output CHANGELOG.md",
        "changelog:preview": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --github-repo Nick2bad4u/typedoc-config-nick2bad4u --unreleased",
        "changelog:release-notes": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --github-repo Nick2bad4u/typedoc-config-nick2bad4u --current",
        "clean:dist": "node scripts/clean-dist.mjs",
        "coverage": "npm run build && vitest run --coverage",
        "diagnose:typedoc-options": "node scripts/diagnose-typedoc-options.mjs",
        "lint": "cross-env NODE_OPTIONS=--max_old_space_size=8192 eslint . --cache --cache-strategy content --cache-location .cache/.eslintcache",
        "lint:all": "npm run lint && npm run typecheck && npm run test && npm run lint:remark && npm run lint:prettier && npm run lint:package && npm run lint:yaml && npm run lint:yamllint && npm run lint:gitleaks && npm run lint:secretlint",
        "lint:all:fix": "npm run lint:fix && npm run lint:remark:fix && npm run lint:prettier:fix && npm run lint:package:fix && npm run typecheck && npm run test && npm run lint:yaml:fix && npm run lint:secretlint",
        "lint:attw": "attw --pack . --profile esm-only",
        "lint:fix": "npm run lint -- --fix",
        "lint:gitleaks": "gitleaks dir --config .gitleaks.toml .",
        "lint:jscpd": "jscpd --config node_modules/jscpd-config-nick2bad4u/jscpd.json",
        "lint:lychee": "lychee --config node_modules/lychee-config-nick2bad4u/lychee.toml .",
        "lint:lychee:smoke": "lychee --config node_modules/lychee-config-nick2bad4u/lychee.toml --dump-inputs README.md",
        "lint:package": "npm run lint:package-sort && npm run lint:package-json && npm run lint:package-check",
        "lint:package:fix": "sort-package-json package.json",
        "lint:package-check": "npm run package:check && npm run lint:publint && npm run lint:attw",
        "lint:package-fix": "npm run lint:package:fix",
        "lint:package-json": "npmPkgJsonLint . --config .npmpackagejsonlintrc.json",
        "lint:package-sort": "sort-package-json --check package.json",
        "lint:prettier": "prettier . --log-level warn --cache --cache-location=.cache/.prettier-cache --cache-strategy=content --check",
        "lint:prettier:fix": "prettier . --log-level warn --cache --cache-location=.cache/.prettier-cache --cache-strategy=content --write",
        "lint:publint": "publint",
        "lint:remark": "remark . --frail --ignore-path .remarkignore",
        "lint:remark:fix": "remark . --ignore-path .remarkignore --output",
        "lint:secretlint": "secretlint --secretlintrc .secretlintrc.cjs --secretlintignore .gitignore \"**/*\"",
        "lint:yaml": "eslint --cache --cache-strategy content --cache-location .cache/.eslintcache \"**/*.{yml,yaml}\"",
        "lint:yaml:fix": "npm run lint:yaml -- --fix",
        "lint:yamllint": "yamllint -c .yamllint .",
        "package:check": "npm pack --dry-run",
        "release:check": "npm run release:verify",
        "release:verify": "npm run build && npm run sync:external-symbol-links:check && npm run lint:all:fix && npm run lint:package-check",
        "sync:external-symbol-links": "node scripts/sync-external-symbol-link-mappings.mjs",
        "sync:external-symbol-links:check": "node scripts/sync-external-symbol-link-mappings.mjs --check",
        "sync:node-version-files": "node scripts/sync-node-version-files.mjs",
        "test": "npm run build && vitest run",
        "test:coverage": "npm run coverage",
        "typecheck": "npm run build && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.eslint.json --noEmit && tsc -p tsconfig.js.json --noEmit && tsc -p tsconfig.vitest-typecheck.json --noEmit",
        "typecheck:all": "npm run typecheck",
        "types:update": "typesync",
        "update-actions": "actions-up --yes --style sha",
        "update-deps": "ncu --configFileName .ncurc.json --configFilePath node_modules/ncu-config-nick2bad4u && npm install && npm run sync:node-version-files",
        "verify": "npm run release:verify"
    },
    "overrides": {
        "tsup": {
            "esbuild": "^0.28.1"
        }
    },
    "dependencies": {
        "typedoc-docusaurus-theme": "^1.4.2",
        "typedoc-plugin-coverage": "^4.0.3",
        "typedoc-plugin-docusaurus-doc-links": "^1.0.3",
        "typedoc-plugin-dt-links": "^2.0.68",
        "typedoc-plugin-external-package-links": "^0.2.0",
        "typedoc-plugin-hash-link-references": "^1.0.3",
        "typedoc-plugin-markdown": "^4.12.0",
        "typedoc-plugin-mdn-links": "^5.1.1",
        "typedoc-plugin-missing-exports": "^4.1.4",
        "typedoc-plugin-remark": "^2.0.1",
        "typedoc-plugin-rename-defaults": "^0.7.3",
        "typedoc-plugin-replace-text": "^4.2.0"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@microsoft/tsdoc-config": "^0.18.1",
        "@types/node": "^26.2.0",
        "@vitest/coverage-v8": "^4.1.11",
        "actions-up": "^1.17.1",
        "cross-env": "^10.1.0",
        "eslint": "^10.9.0",
        "eslint-config-nick2bad4u": "^14.1.0",
        "git-cliff": "^2.13.1",
        "gitcliff-config-nick2bad4u": "^1.5.0",
        "gitleaks-config-nick2bad4u": "^1.0.5",
        "jscpd": "^5.0.16",
        "jscpd-config-nick2bad4u": "^1.1.1",
        "lychee-config-nick2bad4u": "^3.0.0",
        "ncu-config-nick2bad4u": "^0.2.1",
        "npm-check-updates": "^23.0.2",
        "npm-package-json-lint": "^11.0.0",
        "npm-package-json-lint-config-nick2bad4u": "^1.0.4",
        "picocolors": "^1.1.1",
        "prettier": "^3.9.6",
        "prettier-config-nick2bad4u": "^2.0.2",
        "publint": "^0.3.24",
        "remark": "^15.0.1",
        "remark-cli": "^12.0.1",
        "remark-config-nick2bad4u": "^1.1.3",
        "secretlint": "^13.0.4",
        "secretlint-config-nick2bad4u": "^1.1.2",
        "sort-package-json": "^4.0.0",
        "tsdoc-config-nick2bad4u": "^1.0.6",
        "typedoc": "^0.28.20",
        "typescript": "^6.0.3",
        "typesync": "^0.14.3",
        "vite": "^8.2.2",
        "vitest": "^4.1.11",
        "yamllint-config-nick2bad4u": "^1.1.1"
    },
    "peerDependencies": {
        "typedoc": ">=0.28.0"
    },
    "packageManager": "npm@12.0.2",
    "engines": {
        "node": ">=22.0.0"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^22.22.2 || ^24.15.0 || >=26.0.0",
            "onFail": "error"
        },
        "packageManager": {
            "name": "npm",
            "version": ">=12.0.0 <13.0.0",
            "onFail": "error"
        }
    },
    "publishConfig": {
        "provenance": true,
        "registry": "https://registry.npmjs.org/"
    },
    "allowScripts": {
        "core-js": false,
        "fsevents@2.3.3": true,
        "unrs-resolver@1.12.2": true
    },
    "readme": "README.md"
}
